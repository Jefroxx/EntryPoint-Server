APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=entrypoint
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PORTAL_URL=http://localhost:3000

# Only addresses at this domain can register. Leave blank to allow any.
STUDENT_EMAIL_DOMAIN=davao.sti.edu.ph
VERIFY_LINK_MINUTES=60

# Gmail. MAIL_PASSWORD is a 16-character Google app password (myaccount.google.com/apppasswords),
# not the account's normal password — it requires 2-Step Verification to be on first.
# MAIL_FROM_ADDRESS must be the same Gmail address as MAIL_USERNAME.
# Leave MAIL_MAILER=log until those exist: the finished email is then written to
# storage/logs/laravel.log instead of being sent.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Only when hosted (see HOSTING.md) ---
# CORS_ALLOWED_ORIGINS=https://your-site.pages.dev
# DB_SSL_CA_BASE64=      (hosted MySQL certificate, base64 on one line)
# DB_SSL_VERIFY=false    (only if the certificate cannot be used)
# R2_BUCKET= R2_ENDPOINT= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_PUBLIC_URL=   (keep uploads in Cloudflare R2)
# ADMIN_EMAIL= ADMIN_PASSWORD=   (creates the first administrator at start)
# SEED_DEMO=true         (fills an empty database with sample data; demos only)
